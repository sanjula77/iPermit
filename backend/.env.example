DATABASE_URL=postgresql+psycopg2://ipermit:ipermit@db:5432/ipermit
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development

# Set true ONLY on a demo machine: lets the admin panel (page /clear) wipe all driver
# data, keeping admin and police accounts. Leave false anywhere real data lives.
ALLOW_DEMO_RESET=false

# AES-256 master key for the face templates' envelope encryption (32 random bytes,
# base64). Each template has its own data key, wrapped with this one.
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep it secret and back it up; without it the stored templates cannot be read.
FACE_TEMPLATE_KEY=

# Ed25519 key that signs the biometric audit log (32 random bytes, base64). Same command
# as above. Back it up; verify the log with `python -m app.scripts.verify_face_audit`.
AUDIT_SIGNING_KEY=
